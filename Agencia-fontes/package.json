{
  "name": "@agencia/monorepo",
  "version": "0.0.1",
  "description": "Plataforma da Agência Fontes - Templates e Serviços",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "templates/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "dev": "echo 'Run: yarn workspace <name> dev'",
    "build": "echo 'Run: yarn workspace <name> build'",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write '**/*.{ts,tsx,astro,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,astro,json,md}'"
  }
}
