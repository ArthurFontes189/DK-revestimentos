---
import Page from '../layouts/Page.astro';
import { Hero, Card, CTA } from '@agencia/design-system';
import { getFeaturedProjects } from '../data/projects';
import { siteConfig } from '../data/site';

const featuredProjects = getFeaturedProjects();
---

<Page title="Home | Portfolio" description="Welcome to my portfolio">
  <Hero
    title={siteConfig.name}
    subtitle="Crafting beautiful and functional digital experiences"
    ctaText="View My Work"
  />

  <section style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)' }}>
    <h2 style={{
      textAlign: 'center',
      marginBottom: 'var(--spacing-3xl)',
      fontSize: 'var(--text-4xl)',
      fontWeight: 'var(--font-bold)',
    }}>
      Featured Projects
    </h2>

    <div class="portfolio-grid">
      {featuredProjects.map((project) => (
        <a href={`/portfolio/${project.id}`} style={{ textDecoration: 'none' }}>
          <div class="portfolio-item">
            <img src={project.image} alt={project.title} />
            <div class="portfolio-item-overlay">
              <div>
                <h3 style={{ margin: 0, marginBottom: 'var(--spacing-sm)' }}>{project.title}</h3>
                <p style={{ margin: 0, fontSize: 'var(--text-sm)' }}>{project.category}</p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div style={{ textAlign: 'center', marginTop: 'var(--spacing-3xl)' }}>
      <a href="/portfolio" style={{
        display: 'inline-block',
        padding: '12px 24px',
        backgroundColor: 'var(--color-primary)',
        color: 'var(--color-white)',
        borderRadius: 'var(--radius-md)',
        textDecoration: 'none',
        fontWeight: 'var(--font-semibold)',
      }}>
        View All Projects
      </a>
    </div>
  </section>

  <CTA
    title="Ready to Start Your Project?"
    description="Let's create something amazing together"
    buttonText="Get In Touch"
  />
</Page>
