---
import Page from '../layouts/Page.astro';
import { projects, categories } from '../data/projects';
---

<Page title="Portfolio | All Projects" description="View all my creative projects">
  <div style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)' }}>
    <h1 style={{ marginBottom: 'var(--spacing-lg)' }}>My Work</h1>

    <p style={{ color: 'var(--color-text-secondary)', marginBottom: 'var(--spacing-3xl)' }}>
      A selection of recent projects showcasing my skills and expertise
    </p>

    <div style={{ marginBottom: 'var(--spacing-3xl)' }}>
      <div style={{ display: 'flex', gap: 'var(--spacing-md)', flexWrap: 'wrap' }}>
        <a href="/portfolio" style={{
          padding: '8px 16px',
          backgroundColor: 'var(--color-primary)',
          color: 'var(--color-white)',
          borderRadius: 'var(--radius-md)',
          textDecoration: 'none',
          fontSize: 'var(--text-sm)',
          fontWeight: 'var(--font-medium)',
        }}>
          All
        </a>
        {categories.map((cat) => (
          <button style={{
            padding: '8px 16px',
            backgroundColor: 'var(--color-light-gray)',
            border: 'none',
            borderRadius: 'var(--radius-md)',
            cursor: 'pointer',
            fontSize: 'var(--text-sm)',
            fontWeight: 'var(--font-medium)',
          }}>
            {cat}
          </button>
        ))}
      </div>
    </div>

    <div class="portfolio-grid">
      {projects.map((project) => (
        <a href={`/portfolio/${project.id}`} style={{ textDecoration: 'none' }}>
          <div class="portfolio-item">
            <img src={project.image} alt={project.title} />
            <div class="portfolio-item-overlay">
              <div>
                <h3 style={{ margin: 0, marginBottom: 'var(--spacing-sm)' }}>{project.title}</h3>
                <p style={{ margin: 0, fontSize: 'var(--text-sm)' }}>{project.client}</p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Page>
