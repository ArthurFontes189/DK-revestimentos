---
import Page from '../layouts/Page.astro';
import { Card, Grid } from '@agencia/design-system';
import { siteConfig } from '../data/site';
---

<Page title="About | Portfolio" description="Learn more about me">
  <div style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)' }}>
    <h1 style={{ marginBottom: 'var(--spacing-lg)' }}>About Me</h1>

    <div style={{ maxWidth: '800px', margin: '0 auto var(--spacing-3xl)' }}>
      <p style={{ marginBottom: 'var(--spacing-lg)', lineHeight: 'var(--line-relaxed)' }}>
        I'm a passionate designer and developer with a keen eye for detail and a love for creating beautiful digital experiences.
        With over 5+ years of experience in the industry, I've worked with startups and established companies to bring their visions to life.
      </p>
    </div>

    <h2 style={{ marginBottom: 'var(--spacing-lg)' }}>Core Skills</h2>

    <Grid columns={3}>
      <Card>
        <h3>🎨 Design</h3>
        <p>UI/UX Design, Branding, Graphic Design, Web Design</p>
      </Card>
      <Card>
        <h3>💻 Development</h3>
        <p>Web Development, React, Astro, TypeScript, Tailwind</p>
      </Card>
      <Card>
        <h3>📱 Mobile</h3>
        <p>Mobile App Design, App Development, Responsive Design</p>
      </Card>
    </Grid>

    <h2 style={{ marginTop: 'var(--spacing-4xl)', marginBottom: 'var(--spacing-lg)' }}>Experience</h2>

    <div style={{
      paddingLeft: 'var(--spacing-lg)',
      borderLeft: '2px solid var(--color-primary)',
      marginBottom: 'var(--spacing-3xl)',
    }}>
      <div style={{ marginBottom: 'var(--spacing-2xl)' }}>
        <h3 style={{ marginBottom: 'var(--spacing-xs)' }}>Senior Designer</h3>
        <p style={{ color: 'var(--color-text-secondary)', margin: 0 }}>Tech Company | 2022 - Present</p>
      </div>
      <div style={{ marginBottom: 'var(--spacing-2xl)' }}>
        <h3 style={{ marginBottom: 'var(--spacing-xs)' }}>Product Designer</h3>
        <p style={{ color: 'var(--color-text-secondary)', margin: 0 }}>Startup | 2020 - 2022</p>
      </div>
      <div>
        <h3 style={{ marginBottom: 'var(--spacing-xs)' }}>Freelance Designer</h3>
        <p style={{ color: 'var(--color-text-secondary)', margin: 0 }}>Self-employed | 2018 - 2020</p>
      </div>
    </div>
  </div>
</Page>
