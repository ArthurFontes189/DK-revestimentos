---
import { Footer as FooterComponent } from '@agencia/design-system';
import { siteConfig } from '../data/site';

const columns = [
  {
    title: 'Portfolio',
    links: [
      { label: 'All Projects', href: '/portfolio' },
      { label: 'Recent Work', href: '/' },
      { label: 'Case Studies', href: '/portfolio' },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'About Me', href: '/about' },
      { label: 'Services', href: '#' },
      { label: 'Experience', href: '#' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { label: 'Contact', href: '/contact' },
      { label: 'LinkedIn', href: siteConfig.social.linkedin },
      { label: 'Instagram', href: siteConfig.social.instagram },
    ],
  },
];

const social = [
  { platform: 'LinkedIn', url: siteConfig.social.linkedin },
  { platform: 'Instagram', url: siteConfig.social.instagram },
  { platform: 'Behance', url: siteConfig.social.behance },
];

const copyright = `© ${new Date().getFullYear()} ${siteConfig.name}. All rights reserved.`;
---

<FooterComponent
  columns={columns}
  social={social}
  copyright={copyright}
/>
