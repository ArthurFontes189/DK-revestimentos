---
import Page from '../layouts/Page.astro';
import { Hero, Card, Grid, CTA, FeatureGrid } from '@agencia/design-system';
import { siteConfig, cards, features, integrations } from '../data/site';
import { pricingTiers } from '../data/dashboard';

const featuresList = features.map(f => ({
  icon: '✓',
  title: f,
  description: 'Included in all plans',
}));
---

<Page title="Home | SaaS Platform" description="Modern SaaS platform">
  <Hero
    title={siteConfig.name}
    subtitle="Build, measure, and grow with confidence"
    ctaText="Start Free Trial"
  />

  <section id="features" style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)' }}>
    <h2 style={{
      textAlign: 'center',
      marginBottom: 'var(--spacing-3xl)',
      fontSize: 'var(--text-4xl)',
      fontWeight: 'var(--font-bold)',
    }}>
      Powerful Features
    </h2>

    <Grid columns={3}>
      {cards.map((card) => (
        <Card>
          <h3 style={{ marginBottom: 'var(--spacing-md)' }}>{card.title}</h3>
          <div style={{ marginBottom: 'var(--spacing-lg)' }}>
            <div style={{ fontSize: 'var(--text-3xl)', fontWeight: 'var(--font-bold)', color: 'var(--color-primary)' }}>
              {card.value}
            </div>
            <p style={{ fontSize: 'var(--text-sm)', color: 'var(--color-text-secondary)', margin: '0' }}>
              {card.description}
            </p>
          </div>
          {card.trend && (
            <div style={{ fontSize: 'var(--text-sm)', fontWeight: 'var(--font-semibold)', color: card.trend === 'up' ? 'var(--color-success)' : card.trend === 'down' ? 'var(--color-error)' : 'var(--color-accent-cyan)' }}>
              {card.trend === 'up' ? '↑' : card.trend === 'down' ? '↓' : '→'} {card.trendValue}
            </div>
          )}
        </Card>
      ))}
    </Grid>
  </section>

  <section style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)', backgroundColor: 'var(--color-light-gray)' }}>
    <h2 style={{
      textAlign: 'center',
      marginBottom: 'var(--spacing-3xl)',
      fontSize: 'var(--text-4xl)',
      fontWeight: 'var(--font-bold)',
    }}>
      Integrations
    </h2>

    <Grid columns={6}>
      {integrations.map((int) => (
        <Card style={{ textAlign: 'center' } as any}>
          <div style={{ fontSize: '32px', marginBottom: 'var(--spacing-md)' }}>
            {int.icon}
          </div>
          <p style={{ margin: 0, fontWeight: 'var(--font-semibold)' }}>{int.name}</p>
        </Card>
      ))}
    </Grid>
  </section>

  <section style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)' }}>
    <h2 style={{
      textAlign: 'center',
      marginBottom: 'var(--spacing-3xl)',
      fontSize: 'var(--text-4xl)',
      fontWeight: 'var(--font-bold)',
    }}>
      Pricing
    </h2>

    <Grid columns={3}>
      {pricingTiers.map((tier) => (
        <Card style={{
          border: tier.highlighted ? '2px solid var(--color-primary)' : undefined,
          transform: tier.highlighted ? 'scale(1.05)' : undefined,
        } as any}>
          <h3 style={{ marginBottom: 'var(--spacing-md)' }}>{tier.name}</h3>
          <div style={{ marginBottom: 'var(--spacing-lg)' }}>
            <span style={{ fontSize: 'var(--text-3xl)', fontWeight: 'var(--font-bold)', color: 'var(--color-primary)' }}>
              {tier.price}
            </span>
            <span style={{ color: 'var(--color-text-secondary)', fontSize: 'var(--text-sm)' }}>{tier.period}</span>
          </div>
          <p style={{ color: 'var(--color-text-secondary)', marginBottom: 'var(--spacing-lg)' }}>{tier.description}</p>
          <ul class="feature-list" style={{ marginBottom: 'var(--spacing-lg)' }}>
            {tier.features.map((f) => <li>{f}</li>)}
          </ul>
          <button style={{
            width: '100%',
            padding: '12px 24px',
            backgroundColor: 'var(--color-primary)',
            color: 'var(--color-white)',
            borderRadius: 'var(--radius-md)',
            border: 'none',
            fontWeight: 'var(--font-semibold)',
            cursor: 'pointer',
          }}>
            {tier.cta}
          </button>
        </Card>
      ))}
    </Grid>
  </section>

  <CTA
    title="Ready to Get Started?"
    description="Join thousands of companies using our platform"
    buttonText="Start Your Free Trial"
  />
</Page>
