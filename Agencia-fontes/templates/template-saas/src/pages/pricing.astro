---
import Page from '../layouts/Page.astro';
import { Card, Grid } from '@agencia/design-system';
import { pricingTiers } from '../data/dashboard';
---

<Page title="Pricing | SaaS" description="Simple transparent pricing">
  <div style={{ padding: 'var(--spacing-4xl) var(--spacing-lg)' }}>
    <h1 style={{ textAlign: 'center', marginBottom: 'var(--spacing-lg)' }}>Simple Transparent Pricing</h1>

    <p style={{
      textAlign: 'center',
      color: 'var(--color-text-secondary)',
      marginBottom: 'var(--spacing-3xl)',
      maxWidth: '600px',
      margin: '0 auto var(--spacing-3xl)',
    }}>
      Choose the perfect plan for your needs. Always flexible to scale as you grow.
    </p>

    <Grid columns={3}>
      {pricingTiers.map((tier) => (
        <Card style={{
          border: tier.highlighted ? '2px solid var(--color-primary)' : undefined,
          transform: tier.highlighted ? 'scale(1.05)' : undefined,
          position: 'relative',
        } as any}>
          {tier.highlighted && (
            <div style={{
              position: 'absolute',
              top: '-12px',
              left: '50%',
              transform: 'translateX(-50%)',
              backgroundColor: 'var(--color-primary)',
              color: 'var(--color-white)',
              padding: '4px 12px',
              borderRadius: 'var(--radius-full)',
              fontSize: 'var(--text-sm)',
              fontWeight: 'var(--font-semibold)',
            }}>
              Most Popular
            </div>
          )}

          <h3 style={{ marginBottom: 'var(--spacing-md)', marginTop: tier.highlighted ? 'var(--spacing-lg)' : 0 }}>
            {tier.name}
          </h3>

          <div style={{ marginBottom: 'var(--spacing-lg)' }}>
            <span style={{ fontSize: 'var(--text-4xl)', fontWeight: 'var(--font-bold)', color: 'var(--color-primary)' }}>
              {tier.price}
            </span>
            <span style={{ color: 'var(--color-text-secondary)', fontSize: 'var(--text-sm)' }}>
              {tier.period}
            </span>
          </div>

          <p style={{ color: 'var(--color-text-secondary)', marginBottom: 'var(--spacing-lg)' }}>
            {tier.description}
          </p>

          <ul class="feature-list" style={{ marginBottom: 'var(--spacing-lg)' }}>
            {tier.features.map((f) => <li>{f}</li>)}
          </ul>

          <button style={{
            width: '100%',
            padding: '12px 24px',
            backgroundColor: tier.highlighted ? 'var(--color-primary)' : 'var(--color-light-gray)',
            color: tier.highlighted ? 'var(--color-white)' : 'var(--color-primary)',
            borderRadius: 'var(--radius-md)',
            border: 'none',
            fontWeight: 'var(--font-semibold)',
            cursor: 'pointer',
          }}>
            {tier.cta}
          </button>
        </Card>
      ))}
    </Grid>
  </div>
</Page>
