---
import { Footer as FooterComponent } from '@agencia/design-system';
import { siteConfig } from '../data/site';

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#features' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Security', href: '#' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '#' },
      { label: 'Blog', href: '#' },
      { label: 'Careers', href: '#' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '#' },
      { label: 'Terms', href: '#' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];

const social = [
  { platform: 'LinkedIn', url: siteConfig.social.linkedin },
  { platform: 'Twitter', url: siteConfig.social.twitter },
  { platform: 'GitHub', url: siteConfig.social.github },
];

const copyright = `© ${new Date().getFullYear()} ${siteConfig.name}. All rights reserved.`;
---

<FooterComponent
  columns={columns}
  social={social}
  copyright={copyright}
/>
