---
import { Navbar } from '@agencia/design-system';
import { siteConfig } from '../data/site';
---

<Navbar
  logo={siteConfig.logo}
  items={siteConfig.navigation}
/>

<style>
  :global(nav) {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg-default);
    border-bottom: 1px solid var(--color-border);
  }
</style>
