---
import { Footer as FooterComponent } from '@dk-revestimentos/design-system';

interface Props {
  name: string;
  email: string;
  year: number;
  social?: {
    instagram?: string;
    facebook?: string;
    youtube?: string;
  };
}

const { name, email, year, social } = Astro.props;
---

<FooterComponent
  columns={[
    {
      title: 'Empresa',
      links: [
        { label: 'Home', href: '/' },
        { label: 'Serviços', href: '#services' },
        { label: 'Portfólio', href: '#portfolio' },
        { label: 'Contato', href: '#contact' },
      ],
    },
    {
      title: 'Serviços',
      links: [
        { label: 'Pisos', href: '#services' },
        { label: 'Azulejos', href: '#services' },
        { label: 'Marmoraria', href: '#services' },
        { label: 'Instalação', href: '#services' },
      ],
    },
    {
      title: 'Legal',
      links: [
        { label: 'Privacidade', href: '/privacidade' },
        { label: 'Termos', href: '/termos' },
        { label: 'Política', href: '/politica' },
      ],
    },
    {
      title: 'Contato',
      links: [
        { label: 'Email', href: `mailto:${email}` },
        { label: 'WhatsApp', href: 'https://wa.me/5511999999999' },
        { label: 'Instagram', href: social?.instagram || '#' },
      ],
    },
  ]}
  copyright={`© ${year} ${name}. Todos os direitos reservados.`}
/>
