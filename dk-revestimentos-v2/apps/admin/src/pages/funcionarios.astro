---
import Layout from '../layouts/Layout.astro';
import { Navbar, Card, Button, Grid } from '@dk-revestimentos/design-system';

// Mock data
const funcionarios = [
  {
    id: '1',
    name: 'Carlos Silva',
    role: 'Instalador Senior',
    salary: 4000,
    status: 'ativo',
    email: 'carlos@dkrevestimentos.com.br',
  },
  {
    id: '2',
    name: 'João Santos',
    role: 'Instalador Junior',
    salary: 2500,
    status: 'ativo',
    email: 'joao@dkrevestimentos.com.br',
  },
  {
    id: '3',
    name: 'Maria Oliveira',
    role: 'Gerente de Projetos',
    salary: 3500,
    status: 'ativo',
    email: 'maria@dkrevestimentos.com.br',
  },
];
---

<Layout title="Gerenciar Funcionários">
  <Navbar logo="DK Revestimentos Admin">
    <Button variant="outline" size="md" onclick="window.location.href='/login'">
      Sair
    </Button>
  </Navbar>

  <main class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Equipe</h1>
        <Button onclick="alert('Novo funcionário')">+ Contratar</Button>
      </div>

      <Grid columns={3} gap={24}>
        {
          funcionarios.map((func) => (
            <Card variant="elevated" class="cursor-pointer hover:shadow-xl transition-shadow">
              <div class="mb-4">
                <div class="w-12 h-12 bg-blue-200 rounded-full mb-3"></div>
                <h3 class="font-semibold text-lg">{func.name}</h3>
                <p class="text-sm text-gray-600">{func.role}</p>
              </div>

              <div class="space-y-2 text-sm text-gray-600 mb-4 py-4 border-y border-gray-200">
                <p>📧 {func.email}</p>
                <p>💰 R$ {func.salary.toLocaleString('pt-BR')} / mês</p>
                <p class={`font-semibold ${func.status === 'ativo' ? 'text-green-600' : 'text-gray-600'}`}>
                  {func.status === 'ativo' ? '✓ Ativo' : '○ Inativo'}
                </p>
              </div>

              <div class="flex gap-2">
                <Button variant="outline" size="sm" class="flex-1">
                  Editar
                </Button>
                <Button variant="secondary" size="sm" class="flex-1">
                  Mais
                </Button>
              </div>
            </Card>
          ))
        }
      </Grid>

      {/* Salary Summary */}
      <Card variant="elevated" class="mt-12">
        <h2 class="text-xl font-semibold mb-6">Resumo de Folha</h2>
        <div class="grid grid-cols-4 gap-4">
          <div>
            <p class="text-gray-600 text-sm mb-2">Total de Funcionários</p>
            <p class="text-3xl font-bold text-blue-600">{funcionarios.length}</p>
          </div>
          <div>
            <p class="text-gray-600 text-sm mb-2">Folha Mensal</p>
            <p class="text-3xl font-bold text-green-600">
              R$ {funcionarios.reduce((sum, f) => sum + f.salary, 0).toLocaleString('pt-BR')}
            </p>
          </div>
          <div>
            <p class="text-gray-600 text-sm mb-2">Média Salarial</p>
            <p class="text-3xl font-bold text-purple-600">
              R$ {Math.round(funcionarios.reduce((sum, f) => sum + f.salary, 0) / funcionarios.length).toLocaleString('pt-BR')}
            </p>
          </div>
          <div>
            <p class="text-gray-600 text-sm mb-2">Ativos</p>
            <p class="text-3xl font-bold text-yellow-600">
              {funcionarios.filter(f => f.status === 'ativo').length}
            </p>
          </div>
        </div>
      </Card>
    </div>
  </main>
</Layout>
