---
import Layout from '../layouts/Layout.astro';
import { Navbar, Card, Button, Input } from '@dk-revestimentos/design-system';
import { leads } from '../services/supabase';

const allLeads = await leads.getAll();
---

<Layout title="Gerenciar Leads">
  <Navbar logo="DK Revestimentos Admin">
    <Button variant="outline" size="md" onclick="window.location.href='/login'">
      Sair
    </Button>
  </Navbar>

  <main class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Gerenciar Leads</h1>
        <Button onclick="alert('Novo lead')">+ Novo Lead</Button>
      </div>

      {/* Search */}
      <Card variant="default" class="mb-8">
        <div class="flex gap-4 mb-4">
          <Input type="search" placeholder="Buscar por nome ou email..." />
          <Button variant="secondary">Filtrar</Button>
        </div>
      </Card>

      {/* Table */}
      <Card variant="elevated" class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left p-4 font-semibold">Nome</th>
              <th class="text-left p-4 font-semibold">Email</th>
              <th class="text-left p-4 font-semibold">Telefone</th>
              <th class="text-left p-4 font-semibold">Status</th>
              <th class="text-left p-4 font-semibold">Data</th>
              <th class="text-left p-4 font-semibold">Ações</th>
            </tr>
          </thead>
          <tbody>
            {
              allLeads.map((lead) => (
                <tr class="border-b border-gray-200 hover:bg-gray-50">
                  <td class="p-4 font-medium">{lead.name}</td>
                  <td class="p-4">{lead.email}</td>
                  <td class="p-4">{lead.phone}</td>
                  <td class="p-4">
                    <span class={`px-3 py-1 rounded-full text-xs font-semibold ${
                      lead.status === 'novo' ? 'bg-yellow-100 text-yellow-800' :
                      lead.status === 'contato' ? 'bg-blue-100 text-blue-800' :
                      lead.status === 'orçamento' ? 'bg-purple-100 text-purple-800' :
                      lead.status === 'fechado' ? 'bg-green-100 text-green-800' :
                      'bg-red-100 text-red-800'
                    }`}>
                      {lead.status}
                    </span>
                  </td>
                  <td class="p-4 text-gray-600">
                    {new Date(lead.createdAt).toLocaleDateString('pt-BR')}
                  </td>
                  <td class="p-4">
                    <button class="text-blue-600 hover:underline text-xs">
                      Detalhes
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        {allLeads.length === 0 && (
          <div class="p-8 text-center text-gray-500">
            Nenhum lead encontrado
          </div>
        )}
      </Card>

      {/* Pagination */}
      <div class="flex justify-center gap-2 mt-8">
        <Button variant="secondary" size="sm">← Anterior</Button>
        <span class="px-4 py-2">Página 1 de 1</span>
        <Button variant="secondary" size="sm">Próxima →</Button>
      </div>
    </div>
  </main>
</Layout>
