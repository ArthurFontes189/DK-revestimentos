---
import { Card, Grid } from '@dk-revestimentos/design-system';

interface Project {
  id: string;
  title: string;
  category: string;
  image: string;
  client: string;
  description: string;
}

interface Props {
  title: string;
  subtitle?: string;
  projects: Project[];
}

const { title, subtitle, projects } = Astro.props;
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">{title}</h2>
      {subtitle && <p class="text-gray-600 text-lg max-w-2xl mx-auto">{subtitle}</p>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <div class="group cursor-pointer">
            <div class="relative overflow-hidden rounded-lg h-64 mb-4 bg-gray-200">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-40 transition-opacity duration-300"></div>
            </div>
            <Card variant="default">
              <h3 class="text-lg font-semibold mb-2">{project.title}</h3>
              <p class="text-sm text-gray-600 mb-2">{project.description}</p>
              <div class="flex justify-between items-start">
                <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
                  {project.category}
                </span>
                <span class="text-xs text-gray-500">{project.client}</span>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>
