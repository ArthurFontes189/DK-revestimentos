---
import { Button, Input, Card } from '@dk-revestimentos/design-system';

interface Props {
  email: string;
  phone: string;
  whatsapp: string;
  address: string;
}

const { email, phone, whatsapp, address } = Astro.props;
---

<section id="contact" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-4xl font-bold mb-12 text-center">Entre em Contato</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {/* Contact Form */}
      <Card variant="elevated">
        <h3 class="text-xl font-semibold mb-6">Envie sua Mensagem</h3>
        <form class="space-y-4" method="POST" action="#">
          <div client:load>
            <Input label="Nome" type="text" placeholder="Seu nome" required />
          </div>
          <div client:load>
            <Input label="Email" type="email" placeholder="seu@email.com" required />
          </div>
          <div client:load>
            <Input label="Telefone" type="tel" placeholder="(11) 99999-9999" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-gray-700">Mensagem</label>
            <textarea
              placeholder="Descreva sua necessidade..."
              rows={5}
              class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-600"
              required
            ></textarea>
          </div>
          <Button type="submit" size="lg" class="w-full">
            Enviar Mensagem
          </Button>
        </form>
      </Card>

      {/* Contact Info */}
      <div class="space-y-6">
        <h3 class="text-xl font-semibold">Informações de Contato</h3>

        <Card variant="default">
          <div class="flex items-start gap-4">
            <span class="text-2xl">📧</span>
            <div>
              <h4 class="font-semibold mb-1">Email</h4>
              <a href={`mailto:${email}`} class="text-blue-600 hover:underline">
                {email}
              </a>
            </div>
          </div>
        </Card>

        <Card variant="default">
          <div class="flex items-start gap-4">
            <span class="text-2xl">📞</span>
            <div>
              <h4 class="font-semibold mb-1">Telefone</h4>
              <a href={`tel:${phone}`} class="text-blue-600 hover:underline">
                {phone}
              </a>
            </div>
          </div>
        </Card>

        <Card variant="default">
          <div class="flex items-start gap-4">
            <span class="text-2xl">💬</span>
            <div>
              <h4 class="font-semibold mb-1">WhatsApp</h4>
              <a href={whatsapp} target="_blank" class="text-blue-600 hover:underline">
                Clique para conversar
              </a>
            </div>
          </div>
        </Card>

        <Card variant="default">
          <div class="flex items-start gap-4">
            <span class="text-2xl">📍</span>
            <div>
              <h4 class="font-semibold mb-1">Localização</h4>
              <p class="text-gray-600">{address}</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>
